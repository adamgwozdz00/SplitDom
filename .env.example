SUPABASE_URL=###
SUPABASE_KEY=###
# Local only: the app key seeded by supabase/seed.sql. Production uses its own secret.
SUPABASE_APP_KEY=local-dev-app-key
# Local only, used by the smoke test to back-date a billing period: the SERVICE_ROLE_KEY of `npx supabase status -o env`.
# Never set this in production or in the Worker.
SUPABASE_SERVICE_ROLE_KEY=
# Playwright test user, created in the local Supabase only (see context/foundation/test-stack.md).
E2E_USERNAME=
E2E_PASSWORD=
