---
import Layout from "@/layouts/Layout.astro";
import Alert from "@/components/ui/Alert.astro";
import Brand from "@/components/ui/Brand.astro";
import Icon from "@/components/ui/Icon.astro";
import { createGroupService, groupErrorMessage, InviteToken, rememberPendingInvite } from "@/lib/groups";
import { createClient } from "@/lib/supabase";

// The token is a bearer secret in the URL: keep it out of Referer headers sent to other sites and out of every cache.
// "same-origin", not "no-referrer": with no-referrer browsers send `Origin: null` on the join form's POST,
// which Astro's checkOrigin rejects as a cross-site submission.
Astro.response.headers.set("Referrer-Policy", "same-origin");
Astro.response.headers.set("Cache-Control", "no-store");

const INVITE_LOAD_FAILED_MESSAGE = "Nie udało się wczytać zaproszenia, spróbuj ponownie";

const { user } = Astro.locals;
const rawToken = Astro.params.token ?? "";
const token = InviteToken.parse(rawToken);

// Anonymous visitors are sent to sign-in; the cookie brings them back here afterwards. GET consumes nothing.
// (A top-level `return` in frontmatter breaks typescript-eslint's parser, so the redirect is set on the response.)
const toSignIn = token !== null && !user;
if (token && toSignIn) {
  rememberPendingInvite(Astro.cookies, Astro.url, token);
  Astro.response.status = 302;
  Astro.response.headers.set("Location", "/auth/signin");
}

let invalid = token === null;
let loadFailed = false;
let preview: { groupName: string; callerIsMember: boolean } | null = null;

if (token && user) {
  const supabase = createClient(Astro.request.headers, Astro.cookies);
  const result = supabase ? await createGroupService(supabase).previewInvite({ token: token.value }) : null;
  if (result && "data" in result) {
    preview = result.data;
  } else if (result?.error.code === "invite_invalid") {
    invalid = true;
  } else {
    // Any other failure is shown with status 200, never a 500.
    loadFailed = true;
  }
}

if (invalid) {
  Astro.response.status = 404;
}

const errorParam = Astro.url.searchParams.get("error");
const redeemError = errorParam ? groupErrorMessage(errorParam) : null;
---

<Layout title={preview ? "Dołącz do grupy" : "Zaproszenie"}>
  <header class="px-6 pt-5">
    <Brand />
  </header>
  <main class="flex flex-1 flex-col gap-4 px-6 pt-8 pb-6">
    {preview && token ? (
      <>
        <div class="card flex flex-col items-center gap-3 rounded-panel px-5 py-8 text-center">
          <span class="flex size-14 items-center justify-center rounded-[16px] bg-brand-soft text-brand">
            <Icon name="home" size={28} />
          </span>
          <p class="text-sm font-bold text-ink-muted">Zaproszenie do grupy</p>
          <h1 class="text-[28px] font-extrabold tracking-[-0.02em] break-words">{preview.groupName}</h1>
          <p class="text-[15px] text-ink-muted">Dołącz, aby wspólnie zapisywać wydatki i rozliczać się co miesiąc.</p>
        </div>
        {preview.callerIsMember && <Alert variant="info">Już należysz do tej grupy.</Alert>}
        {redeemError && <Alert>{redeemError}</Alert>}
        <div class="flex-1"></div>
        <form method="POST" action="/api/invites/redeem" data-join-invite>
          <input type="hidden" name="token" value={token.value} />
          <button type="submit" class="btn-primary w-full">
            Dołącz do grupy
          </button>
        </form>
      </>
    ) : (
      <>
        <h1 class="text-[28px] font-extrabold tracking-[-0.02em]">Zaproszenie</h1>
        <Alert>{loadFailed ? INVITE_LOAD_FAILED_MESSAGE : groupErrorMessage("invite_invalid")}</Alert>
        {user && (
          <a href="/dashboard" class="btn-secondary w-full">
            Przejdź do swoich grup
          </a>
        )}
      </>
    )}
  </main>
</Layout>

<script>
  // Progressive enhancement: a double tap on "Dołącz do grupy" would send a second POST of an already-used invite,
  // which answers "no longer valid" even though the user did join. Without JavaScript the form still submits.
  for (const form of document.querySelectorAll<HTMLFormElement>("form[data-join-invite]")) {
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    form.addEventListener("submit", () => {
      if (button) button.disabled = true;
    });
    // Coming back through the browser's back/forward cache would otherwise leave the button disabled.
    window.addEventListener("pageshow", () => {
      if (button) button.disabled = false;
    });
  }
</script>
