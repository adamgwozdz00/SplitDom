---
import Layout from "@/layouts/Layout.astro";
import Brand from "@/components/ui/Brand.astro";
import Icon from "@/components/ui/Icon.astro";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      icon: "check",
      heading: "Konto utworzone",
      description: "Twoje konto jest gotowe. Możesz się teraz zalogować.",
      linkText: "Przejdź do logowania",
    }
  : {
      icon: "mail",
      heading: "Sprawdź skrzynkę",
      description: "Wysłaliśmy link potwierdzający na Twój adres e-mail. Kliknij go, aby aktywować konto.",
      linkText: "Wróć do logowania",
    };
---

<Layout title={content.heading}>
  <header class="px-6 pt-5">
    <Brand />
  </header>
  <main class="flex flex-1 flex-col px-6 pt-10 pb-6">
    <div class="card flex flex-col items-center gap-3 px-5 py-8 text-center">
      <span class="flex size-14 items-center justify-center rounded-full bg-brand-soft text-brand">
        <Icon name={content.icon === "check" ? "check" : "mail"} size={26} />
      </span>
      <h1 class="text-2xl font-extrabold tracking-[-0.02em]">{content.heading}</h1>
      <p class="text-[15px] text-ink-muted">{content.description}</p>
    </div>
    <div class="flex-1"></div>
    <a href="/auth/signin" class="btn-primary mt-8 w-full">
      {content.linkText}
    </a>
  </main>
</Layout>
