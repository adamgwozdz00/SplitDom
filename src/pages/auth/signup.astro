---
import Layout from "@/layouts/Layout.astro";
import AuthScreen from "@/components/auth/AuthScreen.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import { hasPendingInvite } from "@/lib/groups";

const error = Astro.url.searchParams.get("error");
const pendingInvite = hasPendingInvite(Astro.cookies);
---

<Layout title="Rejestracja">
  <AuthScreen mode="signup" pendingInvite={pendingInvite}>
    <SignUpForm serverError={error} client:load />
  </AuthScreen>
</Layout>
