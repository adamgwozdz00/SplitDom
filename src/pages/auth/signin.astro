---
import Layout from "@/layouts/Layout.astro";
import AuthScreen from "@/components/auth/AuthScreen.astro";
import SignInForm from "@/components/auth/SignInForm";
import { hasPendingInvite } from "@/lib/groups";

const error = Astro.url.searchParams.get("error");
const pendingInvite = hasPendingInvite(Astro.cookies);
---

<Layout title="Logowanie">
  <AuthScreen mode="signin" pendingInvite={pendingInvite}>
    <SignInForm serverError={error} client:load />
  </AuthScreen>
</Layout>
