---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";
import GoogleSignInButton from "@/components/auth/GoogleSignInButton.astro";
import { hasPendingInvite } from "@/lib/invites";

const error = Astro.url.searchParams.get("error");
const pendingInvite = hasPendingInvite(Astro.cookies);
---

<Layout title="Sign in">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent">
        Sign in
      </h1>
      {pendingInvite && (
        <p class="mb-4 rounded-lg border border-purple-400/30 bg-purple-900/30 px-3 py-2 text-center text-sm text-purple-100">
          Sign in or create an account to accept your invite.
        </p>
      )}
      <GoogleSignInButton />
      <SignInForm serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-blue-100/60">
        Don't have an account?{" "}
        <a href="/auth/signup" class="text-purple-300 hover:underline">
          Sign up
        </a>
      </p>
      <p class="mt-2 text-center text-xs text-blue-100/60">
        <a href="/privacy" class="hover:underline">
          Privacy
        </a>
      </p>
    </div>
  </div>
</Layout>
