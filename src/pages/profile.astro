---
import Layout from "@/layouts/Layout.astro";
import Alert from "@/components/ui/Alert.astro";
import BackHeader from "@/components/ui/BackHeader.astro";
import Avatar from "@/components/ui/Avatar.astro";
import { createMemberProfileService, memberProfileErrorMessage } from "@/lib/member-profiles";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;
// The middleware redirects anonymous requests, so reaching here without a user is a wiring bug.
if (!user) {
  throw new Error("/profile rendered without a signed-in user");
}

// A failure to load only replaces the form, never a 500. The page shows a bank account number: never cache it.
Astro.response.headers.set("Cache-Control", "no-store");
const supabase = createClient(Astro.request.headers, Astro.cookies);
const loaded = supabase ? await createMemberProfileService(supabase).getOwn(user.id) : null;
const profile = loaded && "data" in loaded ? loaded.data : null;

// Only the mapped message is rendered, never the raw query value.
const errorCode = Astro.url.searchParams.get("error");
const error = errorCode ? memberProfileErrorMessage(errorCode) : null;
const saved = Astro.url.searchParams.get("saved") === "1";
const nameErrorCode = Astro.url.searchParams.get("nameError");
const nameError = nameErrorCode ? memberProfileErrorMessage(nameErrorCode) : null;
const nameSaved = Astro.url.searchParams.get("saved") === "name";
const currentName = profile?.displayName?.value ?? "";
const current = profile?.accountNumber ?? null;
const email = user.email ?? "";
---

<Layout title="Profil">
  <BackHeader href="/dashboard" label="Twoje grupy" />
  <main class="flex flex-1 flex-col gap-5 px-6 pt-3 pb-6">
    <div class="flex items-center gap-3.5">
      <Avatar label={currentName || email} isViewer size="md" />
      <div class="min-w-0">
        <h1 class="text-[26px] font-extrabold tracking-[-0.02em]">Profil</h1>
        <p class="truncate text-sm text-ink-muted">{email}</p>
      </div>
    </div>

    {profile && (
      <form
        method="POST"
        action="/api/profile/display-name"
        class="card flex flex-col gap-3 rounded-panel p-[18px]"
        data-profile-form
      >
        <h2 class="text-[17px] font-extrabold">Nazwa wyświetlana</h2>
        <p class="text-sm text-ink-muted">Członkowie Twoich grup widzą ją zamiast Twojego adresu e-mail.</p>
        <div class="flex flex-col gap-1.5">
          <label for="display-name" class="field-label">
            Nazwa
          </label>
          <input
            id="display-name"
            name="displayName"
            type="text"
            autocomplete="nickname"
            value={currentName}
            placeholder="np. Ola"
            aria-invalid={nameError ? "true" : undefined}
            aria-describedby={nameError ? "display-name-error" : "display-name-hint"}
            class="field"
          />
          <p id="display-name-hint" class="field-hint">
            Do 40 znaków. Zostaw puste, aby znów pokazywać e-mail.
          </p>
        </div>
        {nameError && <Alert id="display-name-error">{nameError}</Alert>}
        {nameSaved && !nameError && <Alert variant="success">Zapisano</Alert>}
        <button type="submit" class="btn-secondary w-full">
          Zapisz nazwę
        </button>
      </form>
    )}

    {profile ? (
      <form method="POST" action="/api/profile/account" class="flex flex-1 flex-col gap-4" data-profile-form>
        <section class="card flex flex-col gap-3 rounded-panel p-[18px]">
          <h2 class="text-[17px] font-extrabold">Konto bankowe</h2>
          <p class="text-sm text-ink-muted">
            Ten numer widzą tylko osoby, które są Ci winne pieniądze — aby skopiować go do swojej bankowości. Nikt inny
            go nie zobaczy.
          </p>
          <div class="flex flex-col gap-1.5">
            <label for="account-number" class="field-label">
              Numer konta (NRB)
            </label>
            <input
              id="account-number"
              name="accountNumber"
              type="text"
              inputmode="numeric"
              autocomplete="off"
              value={current ? current.label() : ""}
              placeholder="np. 61 1090 1014 0000 0712 1981 2874"
              aria-invalid={error ? "true" : undefined}
              aria-describedby={error ? "account-number-error" : "account-number-hint"}
              class="field tabular-nums"
            />
            <p id="account-number-hint" class="field-hint">
              26 cyfr. Zostaw puste, aby usunąć numer.
            </p>
          </div>
          {error && <Alert id="account-number-error">{error}</Alert>}
          {saved && !error && <Alert variant="success">Zapisano</Alert>}
        </section>
        <div class="flex-1"></div>
        <button type="submit" class="btn-primary w-full">
          Zapisz
        </button>
      </form>
    ) : (
      <Alert>Nie udało się wczytać Twojego profilu, spróbuj ponownie</Alert>
    )}
  </main>
</Layout>

<script>
  // Progressive enhancement: a double tap must not send the form twice. Without JavaScript it still submits.
  for (const form of document.querySelectorAll<HTMLFormElement>("form[data-profile-form]")) {
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    form.addEventListener("submit", () => {
      if (button) button.disabled = true;
    });
    window.addEventListener("pageshow", () => {
      if (button) button.disabled = false;
    });
  }
</script>
