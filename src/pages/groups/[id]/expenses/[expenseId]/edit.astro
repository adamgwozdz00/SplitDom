---
import Layout from "@/layouts/Layout.astro";
import ExpenseForm from "@/components/expenses/ExpenseForm.astro";
import { memberLabel } from "@/components/expenses/member-label";
import BackHeader from "@/components/ui/BackHeader.astro";
import Icon from "@/components/ui/Icon.astro";
import { billingPeriodErrorMessage, createBillingPeriodService } from "@/lib/billing-periods";
import { createGroupService } from "@/lib/groups";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;
// The middleware redirects anonymous requests, so reaching here without a user is a wiring bug.
if (!user) {
  throw new Error("/groups/[id]/expenses/[expenseId]/edit rendered without a signed-in user");
}

const groupId = Astro.params.id ?? "";
const expenseId = Astro.params.expenseId ?? "";
const groupPage = `/groups/${encodeURIComponent(groupId)}`;

// Anything that stops the viewer from editing (the group or the expense is gone, not theirs, or the period is
// closed) is explained on the group page. (A top-level `return` in frontmatter breaks typescript-eslint's
// parser, so the redirect is set on the response.)
const supabase = createClient(Astro.request.headers, Astro.cookies);
let errorCode: string | null = supabase ? null : "unexpected";
let page: Awaited<ReturnType<ReturnType<typeof createBillingPeriodService>["getEditableExpense"]>> | null = null;
let groupForPage: Awaited<ReturnType<ReturnType<typeof createGroupService>["getForMember"]>> | null = null;
if (supabase) {
  groupForPage = await createGroupService(supabase).getForMember({ groupId, userId: user.id });
  if ("error" in groupForPage) {
    errorCode = groupForPage.error.code;
  } else {
    page = await createBillingPeriodService(supabase).getEditableExpense({
      group: groupForPage.data,
      userId: user.id,
      expenseId,
    });
    if ("error" in page) {
      errorCode = page.error.code;
    }
  }
}
if (errorCode) {
  Astro.response.status = 302;
  Astro.response.headers.set("Location", `${groupPage}?expenseError=${errorCode}`);
}
const group = groupForPage && "data" in groupForPage ? groupForPage.data : null;
const editable = page && "data" in page ? page.data : null;

const errorParam = Astro.url.searchParams.get("expenseError");
const error = errorParam ? billingPeriodErrorMessage(errorParam) : null;
const deleteAction = `/api/groups/${encodeURIComponent(groupId)}/expenses/${encodeURIComponent(expenseId)}/delete`;
---

<Layout title="Edytuj wydatek">
  {group && editable ? (
    <>
      <BackHeader href={groupPage} ariaLabel="Wróć do grupy">
        <div class="flex min-w-0 flex-col">
          <h1 class="text-[17px] font-extrabold">Edytuj wydatek</h1>
          <p class="truncate text-[13px] text-ink-muted">
            {group.name.value} · {editable.period.month.label()}
          </p>
        </div>
      </BackHeader>
      <main class="flex flex-1 flex-col gap-3 px-5 pt-5 pb-6">
        <ExpenseForm
          group={group}
          period={editable.period}
          error={error}
          expense={editable.expense}
          // Only the payer edits an expense, so the label is always the viewer's and needs no display names.
          payerLabel={memberLabel(group.members, editable.expense.payerId, user.id, new Map())}
        />

        <details class="group">
          <summary class="btn-danger h-[50px] w-full list-none group-open:hidden">
            <Icon name="trash" size={18} />
            Usuń wydatek
          </summary>
          <form
            method="POST"
            action={deleteAction}
            class="card flex flex-col gap-3 border-danger-line p-4"
            data-guard-submit
          >
            <p class="text-sm text-ink-soft">
              To usunie wydatek i jego podział dla wszystkich w grupie. Tej operacji nie można cofnąć.
            </p>
            <button type="submit" class="btn-danger-solid w-full">
              Tak, usuń ten wydatek
            </button>
          </form>
        </details>
      </main>
    </>
  ) : null}
</Layout>
