---
import Layout from "@/layouts/Layout.astro";
import GroupCard from "@/components/groups/GroupCard.astro";
import BalancesPanel from "@/components/expenses/BalancesPanel.astro";
import ExpenseForm from "@/components/expenses/ExpenseForm.astro";
import ExpenseList from "@/components/expenses/ExpenseList.astro";
import InvitePanel from "@/components/invites/InvitePanel.astro";
import { createExpenseService, EXPENSES_LOAD_FAILED_MESSAGE, billingPeriodErrorMessage } from "@/lib/billing-periods";
import { createGroupService, groupErrorMessage, GROUPS_LOAD_FAILED_MESSAGE } from "@/lib/groups";
import { inviteErrorMessage, takeNewInvite } from "@/lib/invites";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;
// The middleware redirects anonymous requests, so reaching here without a user is a wiring bug.
if (!user) {
  throw new Error("/groups/[id] rendered without a signed-in user");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
const result = supabase
  ? await createGroupService(supabase).getForMember({ groupId: Astro.params.id ?? "", userId: user.id })
  : null;

const group = result && "data" in result ? result.data : null;
// A non-member and a non-existent id look the same: 404. Any other failure is shown with status 200, never a 500.
const notFound = result !== null && "error" in result && result.error.code === "group_not_found";
if (notFound) {
  Astro.response.status = 404;
}

// The one-time invite link: taken (and deleted) from the cookie only for a group the user belongs to.
const newInvite = group ? takeNewInvite(Astro.cookies, group.id) : null;
const inviteUrl = newInvite ? `${Astro.url.origin}/invite/${newInvite.value}` : null;
if (inviteUrl) {
  // The link is shown once, so neither the browser nor a proxy may keep a copy of this page.
  Astro.response.headers.set("Cache-Control", "no-store");
}
const errorParam = Astro.url.searchParams.get("error");
const inviteError = group && errorParam ? inviteErrorMessage(errorParam) : null;
const expenseErrorParam = Astro.url.searchParams.get("expenseError");
const expenseError = group && expenseErrorParam ? billingPeriodErrorMessage(expenseErrorParam) : null;

// A failure to load expenses only replaces the expenses section; the rest of the page still renders.
const summary = group && supabase ? await createExpenseService(supabase).summarizeOpenPeriod(group) : null;
const expenses = summary && "data" in summary ? summary.data : null;
---

<Layout title={group ? group.name.value : notFound ? groupErrorMessage("group_not_found") : "Group"}>
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-md rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      {group ? (
        <>
          <GroupCard group={group} userId={user.id} />
          <section class="mt-6 border-t border-white/10 pt-6" data-expenses>
            <h2 class="mb-3 text-lg font-semibold text-white">Expenses</h2>
            <ExpenseForm group={group} error={expenseError} />
            {expenses ? (
              <div class="mt-6 space-y-6">
                <BalancesPanel group={group} balances={expenses.balances} viewerId={user.id} />
                <ExpenseList group={group} expenses={expenses.expenses} viewerId={user.id} />
              </div>
            ) : (
              <p
                role="alert"
                class="mt-6 rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300"
              >
                {EXPENSES_LOAD_FAILED_MESSAGE}
              </p>
            )}
          </section>
          <InvitePanel groupId={group.id} inviteUrl={inviteUrl} error={inviteError} />
        </>
      ) : (
        <>
          {notFound ? (
            <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
              {groupErrorMessage("group_not_found")}
            </h1>
          ) : (
            <>
              <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
                Group
              </h1>
              <p role="alert" class="rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300">
                {GROUPS_LOAD_FAILED_MESSAGE}
              </p>
            </>
          )}
          <a href="/dashboard" class="mt-6 inline-block text-sm text-purple-300 hover:underline">
            Back to dashboard
          </a>
        </>
      )}
    </div>
  </div>
</Layout>
