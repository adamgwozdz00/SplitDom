---
import Layout from "@/layouts/Layout.astro";
import GroupCard from "@/components/groups/GroupCard.astro";
import BalancesPanel from "@/components/expenses/BalancesPanel.astro";
import TransferPanel from "@/components/expenses/TransferPanel.astro";
import ClosePeriodPanel from "@/components/expenses/ClosePeriodPanel.astro";
import OpeningDebtList from "@/components/expenses/OpeningDebtList.astro";
import PaymentList from "@/components/expenses/PaymentList.astro";
import PeriodSummary from "@/components/expenses/PeriodSummary.astro";
import ExpenseForm from "@/components/expenses/ExpenseForm.astro";
import ExpenseList from "@/components/expenses/ExpenseList.astro";
import InvitePanel from "@/components/invites/InvitePanel.astro";
import Alert from "@/components/ui/Alert.astro";
import BackHeader from "@/components/ui/BackHeader.astro";
import Icon from "@/components/ui/Icon.astro";
import {
  createBillingPeriodService,
  creditorIdsOf,
  EXPENSES_LOAD_FAILED_MESSAGE,
  billingPeriodErrorMessage,
} from "@/lib/billing-periods";
import { createGroupService, groupErrorMessage, GROUPS_LOAD_FAILED_MESSAGE, takeNewInvite } from "@/lib/groups";
import { createMemberProfileService } from "@/lib/member-profiles";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;
// The middleware redirects anonymous requests, so reaching here without a user is a wiring bug.
if (!user) {
  throw new Error("/groups/[id] rendered without a signed-in user");
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
const result = supabase
  ? await createGroupService(supabase).getForMember({ groupId: Astro.params.id ?? "", userId: user.id })
  : null;

const group = result && "data" in result ? result.data : null;
// A non-member and a non-existent id look the same: 404. Any other failure is shown with status 200, never a 500.
const notFound = result !== null && "error" in result && result.error.code === "group_not_found";
if (notFound) {
  Astro.response.status = 404;
}

// The one-time invite link: taken (and deleted) from the cookie only for a group the user belongs to.
const newInvite = group ? takeNewInvite(Astro.cookies, group.id) : null;
const inviteUrl = newInvite ? `${Astro.url.origin}/invite/${newInvite.value}` : null;
if (inviteUrl) {
  // The link is shown once, so neither the browser nor a proxy may keep a copy of this page.
  Astro.response.headers.set("Cache-Control", "no-store");
}
const errorParam = Astro.url.searchParams.get("error");
const inviteError = group && errorParam ? groupErrorMessage(errorParam) : null;
const expenseErrorParam = Astro.url.searchParams.get("expenseError");
const expenseError = group && expenseErrorParam ? billingPeriodErrorMessage(expenseErrorParam) : null;

const paymentErrorParam = Astro.url.searchParams.get("paymentError");
const paymentError = group && paymentErrorParam ? billingPeriodErrorMessage(paymentErrorParam) : null;

const closeErrorParam = Astro.url.searchParams.get("closeError");

// A failure to load expenses only replaces the period sections; the rest of the page still renders.
const summary = group && supabase ? await createBillingPeriodService(supabase).summarizeOpen(group) : null;
const open = summary && "data" in summary ? summary.data : null;

// Every member sees the month-end banner; the host's refusal is judged on the request time, and the service
// re-judges it on submit.
const now = new Date();
const isHost = group?.isHost(user.id) ?? false;
const closeRefusal =
  group && open && isHost ? open.period.closeRefusal({ userId: user.id, hostId: group.hostId, now }) : null;

// The display names of all members, one call. A failed lookup falls back to emails rather than breaking the page.
const names =
  group && supabase
    ? await createMemberProfileService(supabase).displayNamesFor({
        groupId: group.id,
        userIds: group.members.map((member) => member.userId),
      })
    : null;
const displayNames = names && "data" in names ? names.data : new Map();

// Only the creditors of the viewer's own debts have their account numbers requested. A failed lookup shows
// the "no number yet" state rather than breaking the page.
const creditorIds = open ? creditorIdsOf(open.balances, user.id) : [];
const accounts =
  group && supabase && creditorIds.length > 0
    ? await createMemberProfileService(supabase).accountNumbersFor({ groupId: group.id, userIds: creditorIds })
    : null;
const accountNumbers = accounts && "data" in accounts ? accounts.data : new Map();
// The page can show an account number, so neither the browser nor a proxy may keep a copy.
if (creditorIds.length > 0) {
  Astro.response.headers.set("Cache-Control", "no-store");
}

const awaitingViewer = open
  ? open.payments.filter((payment) => payment.isPending() && payment.recipientId === user.id).length
  : 0;

// The tabs of the period. A failed expense form reopens on its own tab; otherwise the script restores the tab
// the viewer last used in this group.
const tabs = [
  { id: "wydatki", label: "Wydatki" },
  { id: "dlugi", label: "Długi" },
  { id: "wplaty", label: "Wpłaty" },
] as const;
const initialTab = expenseError ? "wydatki" : "";
---

<Layout title={group ? group.name.value : notFound ? groupErrorMessage("group_not_found") : "Grupa"}>
  {group ? (
    <>
      <GroupCard group={group} userId={user.id} />
      <main class="flex flex-1 flex-col gap-4 px-5 pt-4 pb-[118px]">
        {open ? (
          <>
            <PeriodSummary
              period={open.period}
              balances={open.balances}
              viewerId={user.id}
              hasUnconfirmedPayments={open.payments.some((payment) => payment.isPending())}
            />
            {open.period.isOpen() && (
              <ClosePeriodPanel
                group={group}
                period={open.period}
                isHost={isHost}
                refusal={closeRefusal}
                error={closeErrorParam}
                now={now}
              />
            )}
            {paymentError && <Alert>{paymentError}</Alert>}

            <div role="tablist" aria-label="Okres rozliczeniowy" class="segmented grid-cols-3" hidden data-tabs>
              {tabs.map((tab, index) => (
                <button
                  type="button"
                  role="tab"
                  id={`tab-${tab.id}`}
                  aria-controls={`panel-${tab.id}`}
                  aria-selected={index === 0 ? "true" : "false"}
                  tabindex={index === 0 ? 0 : -1}
                  class="segment relative"
                  data-tab={tab.id}
                >
                  {tab.label}
                  {tab.id === "wplaty" && awaitingViewer > 0 && (
                    <span class="ml-1.5 flex size-5 items-center justify-center rounded-full bg-warn text-[11px] text-white">
                      {awaitingViewer}
                      <span class="sr-only">do potwierdzenia</span>
                    </span>
                  )}
                </button>
              ))}
            </div>

            <section
              id="panel-wydatki"
              role="tabpanel"
              aria-labelledby="tab-wydatki"
              class="flex flex-col gap-4"
              data-panel="wydatki"
            >
              <h2 class="sr-only">Wydatki</h2>
              <ExpenseList
                group={group}
                displayNames={displayNames}
                period={open.period}
                expenses={open.expenses}
                viewerId={user.id}
              />
              <section
                id="nowy-wydatek"
                class="card-dashed flex scroll-mt-4 flex-col gap-3 p-[18px]"
                aria-labelledby="new-expense"
              >
                <h3 id="new-expense" class="text-[17px] font-extrabold">
                  Nowy wydatek
                </h3>
                <p class="-mt-1.5 text-[13px] text-ink-muted">Dzielony po równo między wszystkich członków grupy.</p>
                <ExpenseForm group={group} period={open.period} error={expenseError} />
              </section>
            </section>

            <section
              id="panel-dlugi"
              role="tabpanel"
              aria-labelledby="tab-dlugi"
              class="flex flex-col gap-5"
              data-panel="dlugi"
            >
              <h2 class="sr-only">Długi</h2>
              <TransferPanel
                group={group}
                displayNames={displayNames}
                balances={open.balances}
                viewerId={user.id}
                monthLabel={open.period.month.label()}
                accountNumbers={accountNumbers}
              />
              <BalancesPanel group={group} displayNames={displayNames} balances={open.balances} viewerId={user.id} />
              <OpeningDebtList
                group={group}
                displayNames={displayNames}
                openingDebts={open.openingDebts}
                viewerId={user.id}
                previousMonthLabel={open.period.month.previous().label()}
              />
            </section>

            <section
              id="panel-wplaty"
              role="tabpanel"
              aria-labelledby="tab-wplaty"
              class="flex flex-col gap-4"
              data-panel="wplaty"
            >
              <h2 class="sr-only">Wpłaty</h2>
              <PaymentList
                group={group}
                displayNames={displayNames}
                payments={open.payments}
                viewerId={user.id}
                periodOpen={open.period.isOpen()}
                period={open.period}
              />
            </section>

            <script is:inline define:vars={{ storageKey: `sd-tab:${group.id}`, initialTab }}>
              // Runs as soon as the panels are parsed, so the inactive ones never flash. Without JavaScript the
              // tab list stays hidden and every panel shows, one below the other.
              (function () {
                var tablist = document.querySelector("[data-tabs]");
                if (!tablist) return;
                var buttons = Array.prototype.slice.call(tablist.querySelectorAll("[data-tab]"));
                var ids = buttons.map(function (button) {
                  return button.dataset.tab;
                });
                function remembered() {
                  try {
                    return sessionStorage.getItem(storageKey);
                  } catch (error) {
                    return null;
                  }
                }
                function select(id, focus) {
                  buttons.forEach(function (button) {
                    var active = button.dataset.tab === id;
                    button.setAttribute("aria-selected", active ? "true" : "false");
                    button.tabIndex = active ? 0 : -1;
                    if (active && focus) button.focus();
                    var panel = document.getElementById(button.getAttribute("aria-controls"));
                    if (panel) panel.hidden = !active;
                  });
                  try {
                    sessionStorage.setItem(storageKey, id);
                  } catch (error) {
                    // Storage can be unavailable (private mode); the tab still switches.
                  }
                }
                var start = initialTab || remembered();
                select(ids.indexOf(start) >= 0 ? start : ids[0], false);
                tablist.hidden = false;
                buttons.forEach(function (button, index) {
                  button.addEventListener("click", function () {
                    select(button.dataset.tab, false);
                  });
                  button.addEventListener("keydown", function (event) {
                    var step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
                    if (!step) return;
                    event.preventDefault();
                    select(ids[(index + step + ids.length) % ids.length], true);
                  });
                });
                // "Dodaj wydatek" in the bottom bar opens the expenses tab before jumping to the form.
                document.querySelectorAll('a[href="#nowy-wydatek"]').forEach(function (link) {
                  link.addEventListener("click", function () {
                    select("wydatki", false);
                    setTimeout(function () {
                      var amount = document.getElementById("expense-amount");
                      if (amount) amount.focus({ preventScroll: true });
                    }, 0);
                  });
                });
              })();
            </script>
            <div class="fixed bottom-0 left-1/2 z-10 w-full max-w-[480px] -translate-x-1/2 border-t border-line bg-white px-5 pt-3.5 pb-[max(24px,env(safe-area-inset-bottom))]">
              <a href="#nowy-wydatek" class="btn-primary h-[54px] w-full">
                <Icon name="plus" strokeWidth={2.4} />
                Dodaj wydatek
              </a>
            </div>
          </>
        ) : (
          <Alert>{EXPENSES_LOAD_FAILED_MESSAGE}</Alert>
        )}
        <InvitePanel groupId={group.id} inviteUrl={inviteUrl} error={inviteError} />
      </main>
    </>
  ) : (
    <>
      <BackHeader href="/dashboard" label="Twoje grupy" />
      <main class="flex flex-col gap-4 px-6 pt-3">
        {notFound ? (
          <h1 class="text-[28px] font-extrabold tracking-[-0.02em]">{groupErrorMessage("group_not_found")}</h1>
        ) : (
          <>
            <h1 class="text-[28px] font-extrabold tracking-[-0.02em]">Grupa</h1>
            <Alert>{GROUPS_LOAD_FAILED_MESSAGE}</Alert>
          </>
        )}
      </main>
    </>
  )}
</Layout>
