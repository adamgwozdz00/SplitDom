---
import Layout from "@/layouts/Layout.astro";
import CreateGroupForm from "@/components/groups/CreateGroupForm.astro";
import GroupList from "@/components/groups/GroupList.astro";
import Alert from "@/components/ui/Alert.astro";
import Avatar from "@/components/ui/Avatar.astro";
import Icon from "@/components/ui/Icon.astro";
import { createBillingPeriodService } from "@/lib/billing-periods";
import { createGroupService, groupErrorMessage, GROUPS_LOAD_FAILED_MESSAGE } from "@/lib/groups";
import { createClient } from "@/lib/supabase";

const { user } = Astro.locals;
// The middleware redirects anonymous requests, so reaching here without a user is a wiring bug.
if (!user) {
  throw new Error("/dashboard rendered without a signed-in user");
}

// Any failure to load (no Supabase, `unexpected`, `not_authenticated`) replaces the list, never a 500.
const supabase = createClient(Astro.request.headers, Astro.cookies);
const groups = supabase ? await createGroupService(supabase).listForMember(user.id) : null;
// The period summaries are optional: a group whose period cannot be loaded is listed without its summary.
const periods =
  supabase && groups && "data" in groups
    ? await createBillingPeriodService(supabase).openPeriodsOf(groups.data)
    : new Map();

// Only the mapped message is rendered, never the raw query value.
const errorCode = Astro.url.searchParams.get("error");
const formError = errorCode ? groupErrorMessage(errorCode) : null;
const email = user.email ?? "";
---

<Layout title="Twoje grupy">
  <header class="flex items-center justify-between gap-3 pt-5 pr-5 pl-6">
    <div class="flex min-w-0 flex-col gap-0.5">
      <span class="text-sm text-ink-muted">Cześć,</span>
      <span class="truncate text-base font-extrabold">{email}</span>
    </div>
    <a href="/profile" aria-label="Profil i konto bankowe" class="rounded-full">
      <Avatar label={email} isViewer size="md" />
    </a>
  </header>

  <main class="flex flex-1 flex-col gap-7 px-6 pt-7 pb-6">
    <section class="flex flex-col gap-3" aria-labelledby="your-groups">
      <h1 id="your-groups" class="text-[26px] font-extrabold tracking-[-0.02em]">
        Twoje grupy
      </h1>
      {groups && "data" in groups ? (
        <GroupList groups={groups.data} periods={periods} userId={user.id} />
      ) : (
        <Alert>{GROUPS_LOAD_FAILED_MESSAGE}</Alert>
      )}
    </section>

    <section class="card-dashed flex flex-col gap-3 p-[18px]" aria-labelledby="create-group">
      <h2 id="create-group" class="text-[17px] font-extrabold">
        Nowa grupa
      </h2>
      <CreateGroupForm error={formError} />
    </section>

    <div class="flex-1"></div>

    <nav aria-label="Konto" class="card flex flex-col overflow-hidden rounded-panel">
      <a
        href="/profile"
        class="flex min-h-14 items-center gap-3 border-b border-line px-[18px] text-[15px] font-bold text-ink no-underline hover:bg-canvas hover:text-ink"
      >
        <Icon name="user" class="text-sky" />
        <span class="flex-1">Profil i konto bankowe</span>
        <Icon name="chevron-right" size={18} class="text-ink-muted" />
      </a>
      <form method="POST" action="/api/auth/signout">
        <button
          type="submit"
          class="flex min-h-14 w-full cursor-pointer items-center gap-3 px-[18px] text-left text-[15px] font-bold text-ink hover:bg-canvas"
        >
          <Icon name="logout" class="text-ink-muted" />
          <span class="flex-1">Wyloguj się</span>
        </button>
      </form>
    </nav>
  </main>
</Layout>
