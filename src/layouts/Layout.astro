---
import "../styles/global.css";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";

interface Props {
  title?: string;
  /** Extra classes for the page column (the design is a single mobile column, centred on wide screens). */
  class?: string;
}

const { title, class: columnClass } = Astro.props;
const fullTitle = title ? `${title} · SplitDom` : "SplitDom";
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f8f6" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{fullTitle}</title>
  </head>
  <body>
    {missingConfigs.map((cfg) => (
      <Banner variant="error">
        <strong>Uwaga:</strong> {cfg.message}
        {cfg.docsUrl && (
          <>
            {" "}
            <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
              {cfg.docsLabel ?? "Dokumentacja"}
            </a>
            .
          </>
        )}
      </Banner>
    ))}
    <div class:list={["relative mx-auto flex min-h-dvh w-full max-w-[480px] flex-col", columnClass]}>
      <slot />
    </div>
  </body>
</html>
