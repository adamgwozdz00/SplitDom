---
/** The SplitDom logo: two overlapping circles and the name. */
interface Props {
  size?: "sm" | "lg";
}

const { size = "sm" } = Astro.props;
const mark = size === "lg" ? 32 : 24;
---

<span class="flex items-center gap-2.5">
  <svg width={mark} height={mark} viewBox="0 0 32 32" aria-hidden="true">
    <circle cx="12" cy="16" r="10" class="fill-brand"></circle>
    <circle cx="20" cy="16" r="10" class="fill-sky" fill-opacity="0.85"></circle>
  </svg>
  <span class:list={["font-extrabold tracking-tight text-ink", size === "lg" ? "text-xl" : "text-[17px]"]}>
    SplitDom
  </span>
</span>
