---
import { GroupName } from "@/lib/groups";

interface Props {
  error?: string | null;
}

const { error } = Astro.props;
---

<form method="POST" action="/api/groups" class="space-y-3" data-create-group>
  <div>
    <label for="group-name" class="mb-1 block text-sm text-blue-100/80">
      Group name
    </label>
    <input
      id="group-name"
      name="name"
      type="text"
      required
      maxlength={GroupName.MAX_LENGTH}
      autocomplete="off"
      placeholder="e.g. Mokotów flat"
      aria-invalid={error ? "true" : undefined}
      aria-describedby={error ? "group-name-error" : undefined}
      class:list={[
        "w-full rounded-lg border bg-white/10 px-3 py-2 text-white placeholder-white/40 transition-colors focus:ring-2 focus:outline-none",
        error ? "border-red-400/60 focus:ring-red-400" : "border-white/20 focus:ring-purple-400",
      ]}
    />
  </div>
  {error && (
    <p
      id="group-name-error"
      role="alert"
      class="rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300"
    >
      {error}
    </p>
  )}
  <button
    type="submit"
    class="w-full rounded-lg bg-purple-600 px-4 py-2 font-medium text-white transition-colors hover:bg-purple-500 disabled:opacity-60"
  >
    Create group
  </button>
</form>

<script>
  // Progressive enhancement: a double tap on a phone must not create a duplicate group (groups cannot be deleted).
  // Without JavaScript the form still submits normally.
  for (const form of document.querySelectorAll<HTMLFormElement>("form[data-create-group]")) {
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    form.addEventListener("submit", () => {
      if (button) button.disabled = true;
    });
    // Coming back through the browser's back/forward cache would otherwise leave the button disabled.
    window.addEventListener("pageshow", () => {
      if (button) button.disabled = false;
    });
  }
</script>
