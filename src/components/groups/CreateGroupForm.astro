---
import { GroupName } from "@/lib/groups";
import Alert from "@/components/ui/Alert.astro";
import Icon from "@/components/ui/Icon.astro";

interface Props {
  error?: string | null;
}

const { error } = Astro.props;
---

<form method="POST" action="/api/groups" class="flex flex-col gap-3" data-create-group>
  <div class="flex flex-col gap-1.5">
    <label for="group-name" class="field-label">
      Nazwa grupy
    </label>
    <input
      id="group-name"
      name="name"
      type="text"
      required
      maxlength={GroupName.MAX_LENGTH}
      autocomplete="off"
      placeholder="np. Mieszkanie na Mokotowie"
      aria-invalid={error ? "true" : undefined}
      aria-describedby={error ? "group-name-error" : undefined}
      class="field"
    />
  </div>
  {error && <Alert id="group-name-error">{error}</Alert>}
  <button type="submit" class="btn-primary w-full">
    <Icon name="plus" size={18} strokeWidth={2.4} />
    Utwórz grupę
  </button>
</form>

<script>
  // Progressive enhancement: a double tap on a phone must not create a duplicate group (groups cannot be deleted).
  // Without JavaScript the form still submits normally.
  for (const form of document.querySelectorAll<HTMLFormElement>("form[data-create-group]")) {
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    form.addEventListener("submit", () => {
      if (button) button.disabled = true;
    });
    // Coming back through the browser's back/forward cache would otherwise leave the button disabled.
    window.addEventListener("pageshow", () => {
      if (button) button.disabled = false;
    });
  }
</script>
