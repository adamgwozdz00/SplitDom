---
import type { Group } from "@/lib/groups";
import BackHeader from "@/components/ui/BackHeader.astro";
import Icon from "@/components/ui/Icon.astro";

/** The group page's header: back to the group list, the invite shortcut, the group's name and the host badge. */
interface Props {
  group: Group;
  userId: string;
}

const { group, userId } = Astro.props;
---

<BackHeader href="/dashboard" label="Twoje grupy">
  <a slot="actions" href="#zapros" class="btn-icon" aria-label="Zaproś współlokatora">
    <Icon name="user-plus" />
  </a>
</BackHeader>
<div class="flex flex-wrap items-center gap-2.5 px-6 pt-2">
  <h1 class="text-[28px] font-extrabold tracking-[-0.02em] break-words">{group.name.value}</h1>
  {group.isHost(userId) && <span class="pill-sky">Jesteś gospodarzem</span>}
</div>
