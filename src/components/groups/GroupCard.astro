---
import type { Group } from "@/lib/groups";

interface Props {
  group: Group;
  userId: string;
}

const { group, userId } = Astro.props;
---

<h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold break-words text-transparent">
  {group.name.value}
</h1>
{group.isHost(userId) && (
  <p class="mb-2">
    <span class="rounded-full bg-purple-500/20 px-2 py-0.5 text-sm text-purple-200">You are the host</span>
  </p>
)}
<p class="text-blue-100/80">
  Open period: <span class="font-semibold text-white">{group.openPeriod.month.label()}</span>
</p>
<a href="/dashboard" class="mt-6 inline-block text-sm text-purple-300 hover:underline">
  Back to dashboard
</a>
