---
import Alert from "@/components/ui/Alert.astro";
import Icon from "@/components/ui/Icon.astro";

interface Props {
  groupId: string;
  inviteUrl: string | null;
  error: string | null;
}

const { groupId, inviteUrl, error } = Astro.props;
---

<section id="zapros" class="card flex scroll-mt-4 flex-col gap-3.5 p-4" data-invite-panel>
  <div class="flex items-center gap-3.5">
    <div class="flex-1">
      <h2 class="text-[15px] font-extrabold">Zaproś współlokatora</h2>
      <p class="text-[13px] text-ink-muted">Wyślij link, by dołączyć kogoś do grupy</p>
    </div>
    <form method="POST" action={`/api/groups/${encodeURIComponent(groupId)}/invites`} data-generate-invite>
      <button type="submit" class="btn-sky">
        {inviteUrl ? "Nowy link" : "Utwórz link"}
      </button>
    </form>
  </div>
  {error && <Alert>{error}</Alert>}
  {inviteUrl && (
    <div class="flex flex-col gap-2.5 border-t border-line pt-3.5" data-invite-link>
      <label for="invite-url" class="field-label">
        Link z zaproszeniem
      </label>
      <input id="invite-url" type="text" readonly value={inviteUrl} class="field text-sm" />
      <div class="flex gap-2">
        <button type="button" data-copy class="btn-primary h-11 flex-1 rounded-xl text-[15px]">
          <Icon name="copy" size={18} />
          Kopiuj link
        </button>
        <button type="button" data-share hidden class="btn-secondary h-11 flex-1 rounded-xl text-[15px]">
          Udostępnij
        </button>
      </div>
      <p role="status" data-copy-status class="min-h-5 text-sm font-semibold text-brand"></p>
      <p class="field-hint">Działa raz i wygasa po 7 dniach. Ten link zobaczysz tylko teraz.</p>
    </div>
  )}
</section>

<script>
  // Progressive enhancement: without JavaScript the link stays visible for manual copying and the form still submits.
  for (const form of document.querySelectorAll<HTMLFormElement>("form[data-generate-invite]")) {
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    form.addEventListener("submit", () => {
      if (button) button.disabled = true;
    });
    // Coming back through the browser's back/forward cache would otherwise leave the button disabled.
    window.addEventListener("pageshow", () => {
      if (button) button.disabled = false;
    });
  }

  for (const block of document.querySelectorAll<HTMLElement>("[data-invite-link]")) {
    const input = block.querySelector<HTMLInputElement>("input");
    const copy = block.querySelector<HTMLButtonElement>("[data-copy]");
    const share = block.querySelector<HTMLButtonElement>("[data-share]");
    const status = block.querySelector<HTMLElement>("[data-copy-status]");
    if (!input) continue;
    const url = input.value;

    copy?.addEventListener("click", () => {
      // Called synchronously inside the click handler: Safari rejects clipboard writes after an await.
      if (!navigator.clipboard) {
        input.select();
        if (status) status.textContent = "Przytrzymaj link, aby go skopiować";
        return;
      }
      navigator.clipboard.writeText(url).then(
        () => {
          if (status) status.textContent = "Skopiowano link";
        },
        () => {
          input.select();
          if (status) status.textContent = "Nie udało się skopiować — zaznacz link i skopiuj go ręcznie";
        },
      );
    });

    if (share && typeof navigator.share === "function") {
      share.hidden = false;
      share.addEventListener("click", () => {
        // A dismissed share sheet rejects with AbortError; that is not an error for the user.
        navigator.share({ url }).catch(() => undefined);
      });
    }
  }
</script>
