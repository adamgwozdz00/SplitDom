---
import type { BillingMonth, BillingPeriod, Expense } from "@/lib/billing-periods";
import type { Group } from "@/lib/groups";
import type { DisplayNames } from "@/lib/member-profiles";
import { memberLabel } from "@/components/expenses/member-label";

interface Props {
  group: Group;
  displayNames: DisplayNames;
  period: BillingPeriod;
  month: BillingMonth;
  expenses: readonly Expense[];
  viewerId: string;
}

const { group, displayNames, period, month, expenses, viewerId } = Astro.props;
---

<div data-expense-list>
  <h3 class="mb-2 text-sm font-semibold text-blue-100/80">Expenses</h3>
  {expenses.length === 0 ? (
    <p class="text-sm text-blue-100/70">No expenses in {month.label()} yet</p>
  ) : (
    <ul class="space-y-3">
      {expenses.map((expense) => (
        <li class="text-sm">
          <div class="flex items-baseline justify-between gap-3">
            <span class="min-w-0 font-medium break-words text-white">{expense.title.value}</span>
            <span class="shrink-0 font-semibold text-white">{expense.amount.label()}</span>
          </div>
          <div class="text-blue-100/70">
            Paid by {memberLabel(group.members, expense.payerId, viewerId, displayNames)} ·{" "}
            {expense.purchasedOn.label()}
            {period.isOpen() && expense.payerId === viewerId && period.isLocked(expense) && (
              <>
                {" · "}
                <span data-expense-locked>locked</span>
              </>
            )}
            {period.canEdit(expense, viewerId) && (
              <>
                {" · "}
                <a
                  href={`/groups/${encodeURIComponent(group.id)}/expenses/${encodeURIComponent(expense.id)}/edit`}
                  class="text-purple-300 hover:underline"
                >
                  Edit
                </a>
              </>
            )}
          </div>
        </li>
      ))}
    </ul>
  )}
</div>
