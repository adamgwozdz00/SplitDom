---
import type { OpeningDebt } from "@/lib/billing-periods";
import type { Group } from "@/lib/groups";
import type { DisplayNames } from "@/lib/member-profiles";
import { memberLabel } from "@/components/expenses/member-label";
import Icon from "@/components/ui/Icon.astro";

interface Props {
  group: Group;
  displayNames: DisplayNames;
  openingDebts: readonly OpeningDebt[];
  viewerId: string;
  /** e.g. "wrzesień 2026": the month the debts come from. */
  previousMonthLabel: string;
}

const { group, displayNames, openingDebts, viewerId, previousMonthLabel } = Astro.props;

const rows = openingDebts.map((debt) => ({
  debtor: memberLabel(group.members, debt.debtorId, viewerId, displayNames),
  creditor: memberLabel(group.members, debt.creditorId, viewerId, displayNames),
  amountLabel: debt.amount.label(),
}));
---

{rows.length > 0 && (
  <div class="flex flex-col gap-3" data-opening-debts>
    <h3 class="section-title">Przeniesione z poprzedniego miesiąca ({previousMonthLabel})</h3>
    <ul class="card flex flex-col px-4 py-1.5">
      {rows.map((row) => (
        <li class="flex min-h-14 items-center gap-3 border-b border-line py-2 last:border-b-0" data-opening-debt>
          <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-track text-ink-muted">
            <Icon name="history" size={18} />
          </span>
          <span class="min-w-0 flex-1 font-semibold break-words">
            {row.debtor} → {row.creditor}
          </span>
          <span class="amount">{row.amountLabel}</span>
        </li>
      ))}
    </ul>
  </div>
)}
