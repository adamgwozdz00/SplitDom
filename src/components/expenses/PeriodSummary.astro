---
import type { BillingPeriod, PeriodBalances } from "@/lib/billing-periods";

/** The green summary card of the open period: its month, the group's total and the viewer's balance and spend. */
interface Props {
  period: BillingPeriod;
  balances: PeriodBalances;
  viewerId: string;
  /** Whether the balances include a payment the recipient has not confirmed yet. */
  hasUnconfirmedPayments: boolean;
}

const { period, balances, viewerId, hasUnconfirmedPayments } = Astro.props;
const balance = balances.balanceOf(viewerId);
---

<section class="flex flex-col gap-4 rounded-hero bg-brand p-5 text-white" aria-label="Podsumowanie okresu" data-summary>
  <div class="flex items-center justify-between gap-3">
    <span class="text-sm font-bold first-letter:uppercase">{period.month.label()}</span>
    <span class="pill bg-white text-brand">{period.isOpen() ? "Okres otwarty" : "Okres zamknięty"}</span>
  </div>
  <div>
    <p class="amount text-4xl tracking-[-0.02em]">{period.totalExpenses().label()}</p>
    <p class="text-sm text-brand-tint">wydatki grupy w tym miesiącu</p>
  </div>
  <div class="grid grid-cols-2 gap-2.5">
    <div class="rounded-[14px] bg-brand-deep px-3 py-2.5">
      <p class="text-xs font-semibold text-brand-tint">Twoje saldo</p>
      <p class="amount text-[17px]">{balance.signedLabel()}</p>
    </div>
    <div class="rounded-[14px] bg-brand-deep px-3 py-2.5">
      <p class="text-xs font-semibold text-brand-tint">Zapłacone przez Ciebie</p>
      <p class="amount text-[17px]">{period.paidBy(viewerId).label()}</p>
    </div>
  </div>
  {hasUnconfirmedPayments && (
    <p class="text-xs text-brand-tint" data-includes-pending>
      Salda uwzględniają wpłaty oczekujące na potwierdzenie
    </p>
  )}
</section>
