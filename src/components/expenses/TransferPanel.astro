---
import { TransferDetails } from "@/lib/billing-periods";
import type { PeriodBalances } from "@/lib/billing-periods";
import type { Group } from "@/lib/groups";
import type { DisplayNames } from "@/lib/member-profiles";
import type { AccountNumber } from "@/lib/member-profiles";
import { memberLabel } from "@/components/expenses/member-label";
import Icon from "@/components/ui/Icon.astro";

interface Props {
  group: Group;
  displayNames: DisplayNames;
  balances: PeriodBalances;
  viewerId: string;
  monthLabel: string;
  /** Account numbers of the viewer's creditors; a creditor missing from the map has none (or it could not be loaded). */
  accountNumbers: Map<string, AccountNumber>;
}

const { group, displayNames, balances, viewerId, monthLabel, accountNumbers } = Astro.props;

const paymentAction = `/api/groups/${encodeURIComponent(group.id)}/payments`;

const transfers = balances.debts
  .filter((debt) => debt.debtorId === viewerId)
  .map((debt) => {
    const account = accountNumbers.get(debt.creditorId) ?? null;
    return {
      creditorId: debt.creditorId,
      // Identifies this form submission, so sending it twice records the payment once.
      paymentId: crypto.randomUUID(),
      amountInput: debt.amount.formInput(),
      creditor: memberLabel(group.members, debt.creditorId, viewerId, displayNames),
      amountLabel: debt.amount.label(),
      accountLabel: account?.label() ?? null,
      details: TransferDetails.of({
        amount: debt.amount,
        accountDigits: account?.digits ?? null,
        groupName: group.name.value,
        monthLabel,
      }),
    };
  });
---

{transfers.length > 0 && (
  <div class="flex flex-col gap-3" data-transfer-panel>
    <h3 class="section-title">Dane do przelewu</h3>
    <ul class="flex flex-col gap-3">
      {transfers.map((transfer) => (
        <li class="card flex flex-col gap-3 p-4" data-transfer>
          <p class="text-[15px] break-words">
            Oddajesz <span class="font-extrabold">{transfer.creditor}</span>{" "}
            <span class="amount text-brand">{transfer.amountLabel}</span>
          </p>
          <dl class="flex flex-col gap-2.5">
            {transfer.details.account ? (
              <div class="flex items-center justify-between gap-2 rounded-xl bg-canvas px-3 py-2.5">
                <div class="min-w-0">
                  <dt class="text-xs font-semibold text-ink-muted">Numer konta</dt>
                  <dd class="font-bold break-all tabular-nums">{transfer.accountLabel}</dd>
                </div>
                <button type="button" data-copy-value={transfer.details.account} class="btn-chip">
                  <Icon name="copy" size={16} />
                  Kopiuj
                </button>
              </div>
            ) : (
              <p class="rounded-xl bg-warn-soft px-3 py-2.5 text-sm text-warn" data-no-account>
                {transfer.creditor} nie podał(a) jeszcze numeru konta. Poproś o dodanie go w profilu.
              </p>
            )}
            <div class="flex items-center justify-between gap-2 rounded-xl bg-canvas px-3 py-2.5">
              <div class="min-w-0">
                <dt class="text-xs font-semibold text-ink-muted">Kwota</dt>
                <dd class="font-bold tabular-nums">{transfer.details.amount}</dd>
              </div>
              <button type="button" data-copy-value={transfer.details.amount} class="btn-chip">
                <Icon name="copy" size={16} />
                Kopiuj
              </button>
            </div>
            <div class="flex items-center justify-between gap-2 rounded-xl bg-canvas px-3 py-2.5">
              <div class="min-w-0">
                <dt class="text-xs font-semibold text-ink-muted">Tytuł przelewu</dt>
                <dd class="font-bold break-words">{transfer.details.title}</dd>
              </div>
              <button type="button" data-copy-value={transfer.details.title} class="btn-chip">
                <Icon name="copy" size={16} />
                Kopiuj
              </button>
            </div>
          </dl>
          <p role="status" data-copy-status class="min-h-5 text-sm font-semibold text-brand"></p>
          <form method="POST" action={paymentAction} class="flex flex-col gap-1.5 border-t border-line pt-3">
            <input type="hidden" name="recipientId" value={transfer.creditorId} />
            <input type="hidden" name="paymentId" value={transfer.paymentId} />
            <label class="field-label" for={`amount-${transfer.creditorId}`}>
              Kwota, którą wysłałeś(-aś)
            </label>
            <div class="flex gap-2">
              <div class="relative min-w-0 flex-1">
                <input
                  id={`amount-${transfer.creditorId}`}
                  name="amount"
                  type="text"
                  inputmode="decimal"
                  required
                  value={transfer.amountInput}
                  class="field pr-11 tabular-nums"
                />
                <span class="pointer-events-none absolute inset-y-0 right-4 flex items-center font-extrabold text-brand">
                  zł
                </span>
              </div>
              <button type="submit" class="btn-primary shrink-0 px-4 text-[15px]">
                Wysłano
              </button>
            </div>
            <p class="field-hint">Zgłoś przelew po jego wysłaniu — odbiorca potwierdzi, że dotarł.</p>
          </form>
        </li>
      ))}
    </ul>
  </div>
)}

<script>
  // Progressive enhancement: without JavaScript the values stay visible for manual copying.
  for (const block of document.querySelectorAll<HTMLElement>("[data-transfer]")) {
    const status = block.querySelector<HTMLElement>("[data-copy-status]");
    for (const button of block.querySelectorAll<HTMLButtonElement>("[data-copy-value]")) {
      const value = button.dataset.copyValue ?? "";
      button.addEventListener("click", () => {
        // Called synchronously inside the click handler: Safari rejects clipboard writes after an await.
        if (!navigator.clipboard) {
          if (status) status.textContent = "Zaznacz tekst i skopiuj go ręcznie";
          return;
        }
        navigator.clipboard.writeText(value).then(
          () => {
            if (status) status.textContent = "Skopiowano";
          },
          () => {
            if (status) status.textContent = "Nie udało się skopiować — zaznacz tekst i skopiuj go ręcznie";
          },
        );
      });
    }
  }
</script>
