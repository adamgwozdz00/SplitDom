---
import type { Payment } from "@/lib/billing-periods";
import type { Group } from "@/lib/groups";
import { memberLabel } from "@/components/expenses/member-label";

interface Props {
  group: Group;
  /** The period's payments, newest first. */
  payments: readonly Payment[];
  viewerId: string;
  periodOpen: boolean;
}

const { group, payments, viewerId, periodOpen } = Astro.props;

const groupPath = `/api/groups/${encodeURIComponent(group.id)}/payments`;

const rows = payments.map((payment) => {
  const status = payment.status();
  const pending = status === "pending";
  const paymentPath = `${groupPath}/${encodeURIComponent(payment.id)}`;
  return {
    id: payment.id,
    sender: memberLabel(group.members, payment.senderId, viewerId),
    recipient: memberLabel(group.members, payment.recipientId, viewerId),
    amountLabel: payment.amount.label(),
    sentOn: payment.sentOnLabel(),
    statusLabel: status === "pending" ? "awaiting confirmation" : status,
    rejected: status === "rejected",
    // Only the sender withdraws, and only while the payment is pending and the period is open.
    withdrawAction: periodOpen && pending && payment.senderId === viewerId ? `${paymentPath}/withdraw` : null,
    // Only the recipient decides, and only while the payment is pending and the period is open.
    decisionActions: periodOpen && pending && payment.recipientId === viewerId,
    confirmAction: `${paymentPath}/confirm`,
    rejectAction: `${paymentPath}/reject`,
  };
});

const awaitingViewer = rows.filter((row) => row.decisionActions).length;
---

<div data-payment-list>
  <h3 class="mb-2 text-sm font-semibold text-blue-100/80">Payments</h3>
  {awaitingViewer > 0 && (
    <p class="mb-2 text-sm text-amber-200" data-awaiting-confirmation>
      {awaitingViewer === 1
        ? "1 payment awaits your confirmation"
        : `${awaitingViewer} payments await your confirmation`}
    </p>
  )}
  {rows.length === 0 ? (
    <p class="text-sm text-blue-100/70">No payments yet</p>
  ) : (
    <ul class="space-y-2">
      {rows.map((row) => (
        <li class:list={["text-sm", { "opacity-60": row.rejected }]} data-payment>
          <div class="flex items-baseline justify-between gap-3">
            <span class="min-w-0 break-words text-white">
              {row.sender} → {row.recipient}
            </span>
            <span class:list={["shrink-0 font-semibold text-white", { "line-through": row.rejected }]}>
              {row.amountLabel}
            </span>
          </div>
          <div class="text-blue-100/70">
            {row.sentOn} · {row.statusLabel}
            {row.withdrawAction && (
              <form method="POST" action={row.withdrawAction} class="ml-1 inline">
                {" · "}
                <button type="submit" class="text-purple-300 hover:underline">
                  Withdraw
                </button>
              </form>
            )}
            {row.decisionActions && (
              <>
                <form method="POST" action={row.confirmAction} class="ml-1 inline">
                  {" · "}
                  <button type="submit" class="text-purple-300 hover:underline">
                    Confirm
                  </button>
                </form>
                <form method="POST" action={row.rejectAction} class="ml-1 inline">
                  {" · "}
                  <button type="submit" class="text-amber-300 hover:underline">
                    Reject
                  </button>
                </form>
              </>
            )}
          </div>
        </li>
      ))}
    </ul>
  )}
</div>
