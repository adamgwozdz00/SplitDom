---
import { ExpenseTitle } from "@/lib/billing-periods";
import type { BillingPeriod, Expense } from "@/lib/billing-periods";
import type { Group } from "@/lib/groups";
import Alert from "@/components/ui/Alert.astro";
import Icon from "@/components/ui/Icon.astro";

interface Props {
  group: Group;
  period: BillingPeriod;
  error: string | null;
  /** When set, the form edits this expense (prefilled) instead of adding a new one. */
  expense?: Expense;
  /** The edit form shows who paid under the amount. */
  payerLabel?: string;
}

const { group, period, error, expense, payerLabel } = Astro.props;
const window = period.purchaseDateWindow(new Date());
const groupPath = `/api/groups/${encodeURIComponent(group.id)}/expenses`;
const action = expense ? `${groupPath}/${encodeURIComponent(expense.id)}/edit` : groupPath;
const invalid = error ? "true" : undefined;
const describedBy = error ? "expense-error" : undefined;
---

<form method="POST" action={action} class="flex flex-1 flex-col gap-[18px]" data-guard-submit data-expense-form>
  {expense ? (
    <div class="card flex flex-col items-center gap-1 rounded-hero px-5 py-[22px]">
      <label for="expense-amount" class="text-sm font-bold text-ink-muted">
        Kwota
      </label>
      <div class="flex items-baseline justify-center gap-2">
        <input
          id="expense-amount"
          name="amount"
          type="text"
          inputmode="decimal"
          required
          autocomplete="off"
          placeholder="0,00"
          value={expense.amount.formInput()}
          aria-invalid={invalid}
          aria-describedby={describedBy}
          class="w-[190px] rounded-xl border-0 bg-transparent p-0 text-right text-[44px] font-extrabold tracking-[-0.02em] text-ink tabular-nums focus:ring-2 focus:ring-brand/20 focus:outline-none"
        />
        <span class="text-2xl font-extrabold text-brand">zł</span>
      </div>
      {payerLabel && <span class="text-[13px] text-ink-muted">Zapłacił(a): {payerLabel}</span>}
    </div>
  ) : (
    <div class="flex flex-col gap-1.5">
      <label for="expense-amount" class="field-label">
        Kwota
      </label>
      <div class="relative">
        <input
          id="expense-amount"
          name="amount"
          type="text"
          inputmode="decimal"
          required
          autocomplete="off"
          placeholder="0,00"
          aria-invalid={invalid}
          aria-describedby={describedBy}
          class="field pr-12 tabular-nums"
        />
        <span class="pointer-events-none absolute inset-y-0 right-4 flex items-center font-extrabold text-brand">
          zł
        </span>
      </div>
    </div>
  )}
  <div class="flex flex-col gap-1.5">
    <label for="expense-title" class="field-label">
      Tytuł
    </label>
    <input
      id="expense-title"
      name="title"
      type="text"
      required
      maxlength={ExpenseTitle.MAX_LENGTH}
      autocomplete="off"
      placeholder="np. Czynsz"
      value={expense?.title.value}
      aria-invalid={invalid}
      aria-describedby={describedBy}
      class="field"
    />
  </div>
  <div class="flex flex-col gap-1.5">
    <label for="expense-date" class="field-label">
      Data zakupu
    </label>
    <input
      id="expense-date"
      name="purchasedOn"
      type="date"
      required
      min={window.min}
      max={window.max}
      value={expense?.purchasedOn.value ?? window.default}
      aria-invalid={invalid}
      aria-describedby={describedBy}
      class="field"
    />
  </div>
  {error && <Alert id="expense-error">{error}</Alert>}
  {expense && <div class="flex-1"></div>}
  <button type="submit" class="btn-primary w-full">
    {expense ? (
      "Zapisz zmiany"
    ) : (
      <>
        <Icon name="plus" size={18} strokeWidth={2.4} />
        Dodaj wydatek
      </>
    )}
  </button>
</form>

<script>
  // Progressive enhancement: a double tap on a phone must not store a duplicate expense (or repeat a delete).
  // Without JavaScript the forms still submit normally.
  for (const form of document.querySelectorAll<HTMLFormElement>("form[data-guard-submit]")) {
    const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
    form.addEventListener("submit", () => {
      if (button) button.disabled = true;
    });
    // Coming back through the browser's back/forward cache would otherwise leave the button disabled.
    window.addEventListener("pageshow", () => {
      if (button) button.disabled = false;
    });
  }
</script>
