---
import BackHeader from "@/components/ui/BackHeader.astro";
import Brand from "@/components/ui/Brand.astro";
import GoogleSignInButton from "@/components/auth/GoogleSignInButton.astro";
import Alert from "@/components/ui/Alert.astro";

/** The sign-in and sign-up screen: heading, the Logowanie/Rejestracja switch, Google, then the e-mail form (slot). */
interface Props {
  mode: "signin" | "signup";
  pendingInvite: boolean;
}

const { mode, pendingInvite } = Astro.props;
const signIn = mode === "signin";
---

<BackHeader href="/" ariaLabel="Wróć na stronę główną">
  <Brand />
</BackHeader>
<main class="flex flex-1 flex-col px-6 pt-5 pb-6">
  <h1 class="text-[28px] font-extrabold tracking-[-0.02em]">{signIn ? "Witaj ponownie" : "Załóż konto"}</h1>
  <p class="mt-1.5 text-[15px] text-ink-muted">
    {signIn ? "Zaloguj się, aby zobaczyć swoje grupy." : "To zajmie mniej niż minutę."}
  </p>

  <nav aria-label="Logowanie lub rejestracja" class="segmented mt-5 grid-cols-2">
    <a href="/auth/signin" class="segment" aria-current={signIn ? "page" : undefined}>
      Logowanie
    </a>
    <a href="/auth/signup" class="segment" aria-current={signIn ? undefined : "page"}>
      Rejestracja
    </a>
  </nav>

  {pendingInvite && (
    <Alert variant="info" class="mt-4">
      Zaloguj się lub załóż konto, aby przyjąć zaproszenie.
    </Alert>
  )}

  <div class="mt-5">
    <GoogleSignInButton divider />
  </div>

  <slot />

  <p class="mt-3.5 text-center text-xs leading-normal text-ink-muted">
    Kontynuując, akceptujesz{" "}
    <a href="/privacy" class="font-bold">
      politykę prywatności
    </a>
    .
  </p>
</main>
